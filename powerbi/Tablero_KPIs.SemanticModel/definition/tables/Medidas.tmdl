table Medidas
	lineageTag: 81e293fa-0620-42e1-9802-7ae5c6d68ca0

	measure 'KPI1 Ventas' = SUM(FACT_VENTAS[PRECIO])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 56524049-7e86-4e1b-8479-a76783899e65

	measure 'KPI1 Pedidos' = DISTINCTCOUNT(FACT_VENTAS[ORDER_ID])
		formatString: 0
		lineageTag: 057a505f-ed7e-4dca-800c-1cfae966204d

	measure 'Ticket Promedio' = DIVIDE([KPI1 Ventas], [KPI1 Pedidos])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7686f79b-f4d5-4654-88dd-1d098da767c2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Ticket Año Anterior' =
			IF(
			    ISBLANK([Ticket Promedio]),
			    BLANK(),
			    CALCULATE([Ticket Promedio], SAMEPERIODLASTYEAR(DIM_FECHA[FECHA]))
			  )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ff042f0a-5681-48a2-8f7f-36dfff17cd6a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Variación % Ticket' =
			IF(
			    ISBLANK([Ticket Promedio]) || ISBLANK([Ticket Año Anterior]),
			    BLANK(),
			    DIVIDE([Ticket Promedio] - [Ticket Año Anterior], [Ticket Año Anterior])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 66b88899-8909-4b42-909d-f64aa945e5da

	measure 'Línea Base Ticket' = CALCULATE([Ticket Promedio], DATESBETWEEN(DIM_FECHA[FECHA], DATE(2017,1,1),DATE(2017,8,31)))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ebd1cfed-0ffb-45f9-b147-596b2991f9bb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Ticket 2018' = CALCULATE([Ticket Promedio], DATESBETWEEN(DIM_FECHA[FECHA], DATE(2018,1,1),DATE(2018,8,31)))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d164d386-af2f-4334-9527-bff9d2e268b8

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Meta Ticket' = [Línea Base Ticket] * 1.05
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 839b7a0a-34e4-41b2-9c20-6f32820ded75

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Color Semáforo Ticket' = ```
			
			  VAR t = [Ticket Promedio]
			  RETURN
			      SWITCH(
			          TRUE(),
			          ISBLANK(t), "#9E9E9E",
			          t >= [Meta Ticket], "#2E7D32",
			          t >= [Línea Base Ticket], "#F9A825",
			          "#C62828"
			      )
			```
		lineageTag: 6d2b9a0a-f6e3-4d5f-9c20-58b92bb47d77

	partition Medidas = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

